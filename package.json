{
  "name": "tnotesjs-open-folder-in-new-window",
  "displayName": "Open Folder in New Window",
  "description": "Open a folder in a new window from the Explorer context menu.",
  "version": "0.0.1",
  "publisher": "tnotesjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnotesjs/open-folder-in-new-window"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "keywords": ["folder", "workspace", "window", "explorer"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "open-folder-in-new-window.open",
        "title": "在新窗口中打开"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "open-folder-in-new-window.open",
          "when": "explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "open-folder-in-new-window.open",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  }
}
